# signal-tv-classic configuration  ->  /etc/signal-tv-classic/tv.env  (root:signal-tv-classic, mode 0640)
# Edit with:  iptv config        (or the set-* commands, which prompt for secrets)
# Apply with: iptv reload        (re-reads this file and refreshes the catalogue)
# Plain KEY=value lines. This file is read by the app, never sourced by a shell.

# m3u  = an M3U/M3U8 playlist URL (IPTV_M3U_URL), optional XMLTV guide (IPTV_EPG_URL)
# xtream = Xtream Codes API (XTREAM_*); the guide defaults to the panel's xmltv.php
IPTV_PROVIDER_TYPE=m3u

IPTV_M3U_URL=
IPTV_EPG_URL=

XTREAM_BASE_URL=
XTREAM_USERNAME=
XTREAM_PASSWORD=

# Optional tuning
# User-Agent sent to the provider (many panels expect a player UA)
IPTV_USER_AGENT=
# Catalogue / guide refresh interval in hours
IPTV_REFRESH_HOURS=12
IPTV_EPG_REFRESH_HOURS=12
# Concurrent provider connections the app may open (check your subscription)
IPTV_MAX_LIVE_STREAMS=2
IPTV_MAX_VOD_REMUX=2
